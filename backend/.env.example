# ============================================================
# Atelier Boutique – Django Backend Environment Template
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. All values below are
# documented placeholders.

# --- Django Core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Set to False in production.
DJANGO_DEBUG=True
# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Supabase PostgreSQL) ---
# The production commerce database is Supabase PostgreSQL.
# The Django ORM connects here using the service connection string.
# When unset, Django falls back to SQLite (db.sqlite3) for local
# experimentation only.  DO NOT commit a real password.
#
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Supabase (JWT verification + service access) ---
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Service-role key: SERVER ONLY. Never ship to the browser/React.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# --- Frontend origin (CORS) ---
FRONTEND_ORIGIN=http://127.0.0.1:3000

# --- Google AI (product description/image generation) ---
GOOGLE_API_KEY=<google-api-key>
GOOGLE_PRODUCT_MODEL=gemini-3.6-flash
GOOGLE_IMAGE_MODEL=imagen-3.0-generate-002

# --- Payments / M-Pesa ---
# Shared webhook verification secrets (server-side only).
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
MPESA_CALLBACK_SECRET=replace-with-a-long-random-secret